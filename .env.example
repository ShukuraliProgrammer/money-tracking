# MoneyTrack UZ sozlamalari. Bu fayldan nusxa oling:  cp .env.example .env
# .env faylini hech qachon git'ga qo'shmang.

# --- Majburiy ---------------------------------------------------------------
# @BotFather bergan token
BOT_TOKEN=

# Izoh va asl xabarlarni shifrlash kaliti. Yaratish:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Kalitni yo'qotsangiz, saqlangan izohlarni o'qib bo'lmaydi. Zaxira nusxasini saqlang.
ENCRYPTION_KEY=

# --- Ma'lumotlar bazasi -------------------------------------------------------
# SQLite (standart):
DATABASE_URL=sqlite+aiosqlite:///./data/moneytrack.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://moneytrack:PAROL@postgres:5432/moneytrack

# --- Suhbat holati (ixtiyoriy) ------------------------------------------------
# Bo'sh qoldirilsa, holat xotirada saqlanadi (bot qayta ishga tushsa, tugallanmagan suhbat unutiladi).
# REDIS_URL=redis://redis:6379/0

# --- LLM (ixtiyoriy) ----------------------------------------------------------
# none      - faqat qoidalar (CardXabar, HUMO, bank SMS formatlari LLM'siz o'qiladi; screenshot o'qilmaydi)
# anthropic - qoidalar tushunmagan matn Claude'ga yuboriladi
# openai    - qoidalar tushunmagan matn OpenAI modeliga yuboriladi
# Screenshot (rasm) faqat anthropic yoki openai sozlanganda o'qiladi.
LLM_PROVIDER=none

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

LLM_TIMEOUT_SECONDS=30
# JSON noto'g'ri kelsa, necha marta so'raladi
LLM_MAX_ATTEMPTS=3
# Izohni («Bu nima uchun edi?») ham LLM bilan tahlil qilish
LLM_NOTE_ANALYSIS=true

# --- Standart qiymatlar -------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_CURRENCY=UZS
LOG_LEVEL=INFO

# --- Faqat docker compose --profile postgres uchun ----------------------------
# POSTGRES_PASSWORD=
